# Local development
LUCRETIA_ACCESS_TOKEN=dev-token

# Optional hosted-to-local relay
LUCRETIA_WORKER_TOKEN=replace-with-a-random-secret

# Optional paid provider adapter
RUNWAY_API_KEY=
RUNWAY_API_BASE=https://api.dev.runwayml.com/v1
RUNWAY_API_VERSION=2024-11-06
RUNWAY_MODEL=seedance2_fast
RUNWAY_DEFAULT_DURATION=5
RUNWAY_DRY_RUN=true

# Local generation backend
LUCRETIA_COMFY_MODE=external
LUCRETIA_COMFY_URL=http://127.0.0.1:8188
